<UserControl x:Class="OMNIX.Core.Ui.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="360" d:DesignHeight="620"
             Background="{DynamicResource B.Background}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OMNIX.Core;component/Ui/Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LinkCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource B.Surface}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="LinkName" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
            </Style>
            <Style x:Key="LinkHandle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{DynamicResource B.ForegroundDim}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
        <StackPanel>

            <TextBlock Text="OMNIX" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource B.Accent}" />
            <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11"
                       Foreground="{DynamicResource B.ForegroundDim}" Margin="0,0,0,10" />

            <TextBlock Text="Powered by Mr Ali" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Foreground}" Margin="0,0,0,6" />

            <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                       Foreground="{DynamicResource B.ForegroundDim}"
                       Text="Created and developed by Mr Ali, an independent developer building practical digital tools, automation solutions, and useful projects. Follow the channels above for updates, new projects, and useful content." />

            <TextBlock Text="Email" Style="{StaticResource LinkName}" Margin="0,14,0,4" />
            <Border Style="{StaticResource LinkCard}" MouseLeftButtonUp="Open_Email">
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Fill="{DynamicResource B.Accent}"
                          Data="{StaticResource IconGeometry.Gmail}" Stretch="Uniform" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Email" Style="{StaticResource LinkName}" />
                        <TextBlock Text="Ali.hekmati2026@gmail.com" Style="{StaticResource LinkHandle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LinkCard}" MouseLeftButtonUp="Open_Telegram">
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Fill="{DynamicResource B.Accent}"
                          Data="{StaticResource IconGeometry.Telegram}" Stretch="Uniform" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Telegram" Style="{StaticResource LinkName}" />
                        <TextBlock Text="@Mr_Ali_2025" Style="{StaticResource LinkHandle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LinkCard}" MouseLeftButtonUp="Open_TelegramChannel">
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Fill="{DynamicResource B.Accent}"
                          Data="{StaticResource IconGeometry.TelegramChannel}" Stretch="Uniform" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Telegram Channel" Style="{StaticResource LinkName}" />
                        <TextBlock Text="@Ali_shortcuts" Style="{StaticResource LinkHandle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LinkCard}" MouseLeftButtonUp="Open_Facebook">
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Fill="{DynamicResource B.Accent}"
                          Data="{StaticResource IconGeometry.Facebook}" Stretch="Uniform" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Facebook" Style="{StaticResource LinkName}" />
                        <TextBlock Text="AliShortcuts" Style="{StaticResource LinkHandle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LinkCard}" MouseLeftButtonUp="Open_TikTok">
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Fill="{DynamicResource B.Accent}"
                          Data="{StaticResource IconGeometry.TikTok}" Stretch="Uniform" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="TikTok" Style="{StaticResource LinkName}" />
                        <TextBlock Text="@ali_shortcuts" Style="{StaticResource LinkHandle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LinkCard}" MouseLeftButtonUp="Open_Instagram">
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Fill="{DynamicResource B.Accent}"
                          Data="{StaticResource IconGeometry.Instagram}" Stretch="Uniform" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Instagram" Style="{StaticResource LinkName}" />
                        <TextBlock Text="@ali_shortcuts" Style="{StaticResource LinkHandle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LinkCard}" MouseLeftButtonUp="Open_YouTube">
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Fill="{DynamicResource B.Accent}"
                          Data="{StaticResource IconGeometry.YouTube}" Stretch="Uniform" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="YouTube" Style="{StaticResource LinkName}" />
                        <TextBlock Text="@Ali_Shortcuts" Style="{StaticResource LinkHandle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
