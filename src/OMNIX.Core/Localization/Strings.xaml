<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- === General UI === -->
    <sys:String x:Key="S.AppName">OMNIX</sys:String>
    <sys:String x:Key="S.Tab.Chat">Chat</sys:String>
    <sys:String x:Key="S.Tab.Settings">Settings</sys:String>
    <sys:String x:Key="S.Tab.About">About</sys:String>

    <!-- === Ribbon === -->
    <sys:String x:Key="S.Ribbon.OpenWorkspace">Open Workspace</sys:String>
    <sys:String x:Key="S.Ribbon.Settings">Settings</sys:String>
    <sys:String x:Key="S.Ribbon.TabLabel">OMNIX</sys:String>

    <!-- === Chat === -->
    <sys:String x:Key="S.Chat.Send">Send</sys:String>
    <sys:String x:Key="S.Chat.Stop">Stop</sys:String>
    <sys:String x:Key="S.Chat.NewChat">New Chat</sys:String>
    <sys:String x:Key="S.Chat.Copy">Copy</sys:String>
    <sys:String x:Key="S.Chat.Retry">Retry</sys:String>
    <sys:String x:Key="S.Chat.Clear">Clear</sys:String>
    <sys:String x:Key="S.Chat.InputPlaceholder">Ask about this document… (Enter to send, Shift+Enter for new line)</sys:String>
    <sys:String x:Key="S.Chat.You">You</sys:String>
    <sys:String x:Key="S.Chat.Assistant">OMNIX AI</sys:String>
    <sys:String x:Key="S.Chat.AttachImage">Attach image from this document</sys:String>
    <sys:String x:Key="S.Chat.UploadImage">Upload image file…</sys:String>
    <sys:String x:Key="S.Chat.AttachedImage">Image attached</sys:String>
    <sys:String x:Key="S.Chat.ContextSee">AI sees:</sys:String>
    <sys:String x:Key="S.Chat.Thinking">Thinking…</sys:String>
    <sys:String x:Key="S.Chat.Cancelled">(cancelled)</sys:String>
    <sys:String x:Key="S.Chat.Copied">Copied to clipboard</sys:String>
    <sys:String x:Key="S.Chat.NothingToCopy">Nothing to copy</sys:String>
    <sys:String x:Key="S.Chat.RetryEmpty">Nothing to retry yet</sys:String>
    <sys:String x:Key="S.Chat.Cleared">Conversation cleared</sys:String>
    <sys:String x:Key="S.Chat.NewSession">New conversation started</sys:String>

    <!-- === Privacy === -->
    <sys:String x:Key="S.Privacy.ConfirmTitle">Send to Cloud AI?</sys:String>
    <sys:String x:Key="S.Privacy.ConfirmText">The current request (which may include parts of this document) would be sent to the cloud provider "{0}". Do you allow this?</sys:String>
    <sys:String x:Key="S.Privacy.SessionRemember">Don't ask again for this session</sys:String>
    <sys:String x:Key="S.Privacy.LocalOnlyBlocked">Privacy Mode is "Local Only" — this request was blocked because the selected provider "{0}" is a cloud provider. Switch to a local AI provider (Ollama / LM Studio) or change Privacy Mode in Settings.</sys:String>

    <!-- === Settings === -->
    <sys:String x:Key="S.Settings.Provider">AI Provider</sys:String>
    <sys:String x:Key="S.Settings.Model">Model</sys:String>
    <sys:String x:Key="S.Settings.ApiKey">API Key</sys:String>
    <sys:String x:Key="S.Settings.ApiKeyStored">Stored encrypted (DPAPI)</sys:String>
    <sys:String x:Key="S.Settings.LoadModels">Load models</sys:String>
    <sys:String x:Key="S.Settings.TestConnection">Test connection</sys:String>
    <sys:String x:Key="S.Settings.TestOk">Connection OK</sys:String>
    <sys:String x:Key="S.Settings.TestFailed">Connection failed</sys:String>
    <sys:String x:Key="S.Settings.LocalStatus">Local AI status</sys:String>
    <sys:String x:Key="S.Settings.ProbeNow">Probe now</sys:String>
    <sys:String x:Key="S.Settings.Available">Available</sys:String>
    <sys:String x:Key="S.Settings.NotAvailable">Not available</sys:String>
    <sys:String x:Key="S.Settings.PrivacyMode">Privacy Mode (applied in the AI Gateway before any cloud call)</sys:String>
    <sys:String x:Key="S.Settings.Privacy.LocalOnly">Local Only — data never leaves this PC</sys:String>
    <sys:String x:Key="S.Settings.Privacy.CloudAllowed">Cloud Allowed</sys:String>
    <sys:String x:Key="S.Settings.Privacy.AskBeforeSending">Ask before sending (recommended default)</sys:String>
    <sys:String x:Key="S.Settings.Appearance">Appearance</sys:String>
    <sys:String x:Key="S.Settings.Theme.System">System</sys:String>
    <sys:String x:Key="S.Settings.Theme.Light">Light</sys:String>
    <sys:String x:Key="S.Settings.Theme.Dark">Dark</sys:String>
    <sys:String x:Key="S.Settings.Language">Interface language</sys:String>
    <sys:String x:Key="S.Settings.HistoryLimits">Chat history limits</sys:String>
    <sys:String x:Key="S.Settings.History.Messages">Max messages</sys:String>
    <sys:String x:Key="S.Settings.History.Days">Max age (days)</sys:String>
    <sys:String x:Key="S.Settings.ContextLimits">Context limits (per request)</sys:String>
    <sys:String x:Key="S.Settings.Context.Cells">Max cells</sys:String>
    <sys:String x:Key="S.Settings.Context.Tokens">Max tokens</sys:String>
    <sys:String x:Key="S.Settings.PreferLocal">Prefer Local AI when available</sys:String>
    <sys:String x:Key="S.Settings.CustomProvider">Custom provider (OpenAI-compatible)</sys:String>
    <sys:String x:Key="S.Settings.CustomName">Name</sys:String>
    <sys:String x:Key="S.Settings.CustomBaseUrl">Base URL</sys:String>
    <sys:String x:Key="S.Settings.Saved">Settings saved</sys:String>
    <sys:String x:Key="S.Settings.VisionSupported">This provider/model supports image analysis (Vision).</sys:String>
    <sys:String x:Key="S.Settings.VisionNotSupported">This provider/model does NOT support image analysis (Vision).</sys:String>
    <sys:String x:Key="S.Settings.VisionUnknown">Vision support unknown — test with an image to find out.</sys:String>

    <!-- === Tools === -->
    <sys:String x:Key="S.Tools.ConfirmTitle">OMNIX wants to modify this document</sys:String>
    <sys:String x:Key="S.Tools.ConfirmApply">Apply</sys:String>
    <sys:String x:Key="S.Tools.ConfirmCancel">Cancel</sys:String>
    <sys:String x:Key="S.Tools.UndoHint">You can undo this with Ctrl+Z (native Office undo).</sys:String>
    <sys:String x:Key="S.Tools.UnknownTool">Unknown or non-whitelisted tool requested: {0}</sys:String>
    <sys:String x:Key="S.Tools.Applied">Change applied — press Ctrl+Z to undo.</sys:String>
    <sys:String x:Key="S.Tools.CancelledByUser">The change was cancelled by the user.</sys:String>

    <!-- === Errors === -->
    <sys:String x:Key="Err.Network">Network error while contacting the AI provider. The request could not reach the endpoint.</sys:String>
    <sys:String x:Key="Err.NetworkFix">Check that the endpoint address is correct, your network allows it, and any local AI server (if used) is running.</sys:String>
    <sys:String x:Key="Err.Timeout">The AI provider did not answer in time and the request timed out.</sys:String>
    <sys:String x:Key="Err.TimeoutFix">Try again, or pick a faster model/provider.</sys:String>
    <sys:String x:Key="Err.Auth">Authentication failed — the provider rejected the API key.</sys:String>
    <sys:String x:Key="Err.AuthFix">Open Settings, re-enter the API key for this provider and test the connection.</sys:String>
    <sys:String x:Key="Err.Model">The selected model is not available on this provider.</sys:String>
    <sys:String x:Key="Err.ModelFix">Use "Load models" in Settings and pick a model the provider actually offers.</sys:String>
    <sys:String x:Key="Err.Provider">The AI provider reported an error.</sys:String>
    <sys:String x:Key="Err.ProviderFix">Retry. If it persists, switch provider/model in Settings.</sys:String>
    <sys:String x:Key="Err.Generic">An unexpected error occurred inside OMNIX.</sys:String>
    <sys:String x:Key="Err.GenericFix">Please retry. Details were written to the OMNIX log folder.</sys:String>
    <sys:String x:Key="Err.TechnicalDetails">Technical details:</sys:String>
    <sys:String x:Key="Err.SuggestedFix">Suggested fix:</sys:String>
    <sys:String x:Key="Err.VisionNotSupported">This provider/model does not support image analysis. Choose a Vision-capable provider (for example Gemini) in Settings.</sys:String>

    <!-- === About (exact, fixed content — spec Section 8) === -->
    <sys:String x:Key="S.About.Title">Powered by Mr Ali</sys:String>
    <sys:String x:Key="S.About.Text">Created and developed by Mr Ali, an independent developer building practical digital tools, automation solutions, and useful projects. Follow the channels above for updates, new projects, and useful content.</sys:String>

    <!-- === Installer / misc === -->
    <sys:String x:Key="S.Misc.Version">Version</sys:String>
    <sys:String x:Key="S.Misc.Office">Host</sys:String>
</ResourceDictionary>
