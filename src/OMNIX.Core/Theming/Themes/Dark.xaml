<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- OMNIX Dark theme — coal background, OMNIX purple accent -->
    <Color x:Key="C.Background">#1E1E1E</Color>
    <Color x:Key="C.Surface">#252526</Color>
    <Color x:Key="C.Foreground">#E6E6E6</Color>
    <Color x:Key="C.ForegroundDim">#9A9A9A</Color>
    <Color x:Key="C.Accent">#9B7CFF</Color>
    <Color x:Key="C.AccentForeground">#14101F</Color>
    <Color x:Key="C.Border">#3A3A3E</Color>
    <Color x:Key="C.BubbleUser">#7C5CFF</Color>
    <Color x:Key="C.BubbleUserForeground">#FFFFFF</Color>
    <Color x:Key="C.BubbleAi">#2C2C30</Color>
    <Color x:Key="C.BubbleAiForeground">#E6E6E6</Color>
    <Color x:Key="C.CodeBackground">#26262B</Color>
    <Color x:Key="C.CodeKeyword">#C9A6FF</Color>
    <Color x:Key="C.CodeString">#7FD19C</Color>
    <Color x:Key="C.CodeComment">#7A7A85</Color>
    <Color x:Key="C.CodeNumber">#E8A45A</Color>
    <Color x:Key="C.Link">#B9A5FF</Color>
    <Color x:Key="C.Danger">#EF6A6A</Color>
    <Color x:Key="C.Success">#7FD19C</Color>

    <SolidColorBrush x:Key="B.Background" Color="{DynamicResource C.Background}" />
    <SolidColorBrush x:Key="B.Surface" Color="{DynamicResource C.Surface}" />
    <SolidColorBrush x:Key="B.Foreground" Color="{DynamicResource C.Foreground}" />
    <SolidColorBrush x:Key="B.ForegroundDim" Color="{DynamicResource C.ForegroundDim}" />
    <SolidColorBrush x:Key="B.Accent" Color="{DynamicResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentForeground" Color="{DynamicResource C.AccentForeground}" />
    <SolidColorBrush x:Key="B.Border" Color="{DynamicResource C.Border}" />
    <SolidColorBrush x:Key="B.BubbleUser" Color="{DynamicResource C.BubbleUser}" />
    <SolidColorBrush x:Key="B.BubbleUserForeground" Color="{DynamicResource C.BubbleUserForeground}" />
    <SolidColorBrush x:Key="B.BubbleAi" Color="{DynamicResource C.BubbleAi}" />
    <SolidColorBrush x:Key="B.BubbleAiForeground" Color="{DynamicResource C.BubbleAiForeground}" />
    <SolidColorBrush x:Key="B.CodeBackground" Color="{DynamicResource C.CodeBackground}" />
    <SolidColorBrush x:Key="B.CodeKeyword" Color="{DynamicResource C.CodeKeyword}" />
    <SolidColorBrush x:Key="B.CodeString" Color="{DynamicResource C.CodeString}" />
    <SolidColorBrush x:Key="B.CodeComment" Color="{DynamicResource C.CodeComment}" />
    <SolidColorBrush x:Key="B.CodeNumber" Color="{DynamicResource C.CodeNumber}" />
    <SolidColorBrush x:Key="B.Link" Color="{DynamicResource C.Link}" />
    <SolidColorBrush x:Key="B.Danger" Color="{DynamicResource C.Danger}" />
    <SolidColorBrush x:Key="B.Success" Color="{DynamicResource C.Success}" />
</ResourceDictionary>
